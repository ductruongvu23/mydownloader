{
  "appId": "com.example.mydownloader",
  "productName": "MyDownloader",
  "directories": {
    "output": "dist"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "ductruongvu23",
      "repo": "mydownloader"
    }
  ],
  "files": [
    "out/**/*",
    "resources/**/*"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": "resources"
    },
    {
      "from": "extension",
      "to": "extension"
    }
  ],
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
