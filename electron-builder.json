{
  "appId": "com.example.mydownloader",
  "productName": "MyDownloader",
  "directories": {
    "output": "dist"
  },
  "files": [
    "out/**/*",
    "resources/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
